# Never commit: dependencies and environment secrets
node_modules/
.env

# Next.js
.next/
out/

# Local env overrides (keep .env.example in git)
.env*.local

# Debug / OS
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
.vercel

# Android release signing
android/keystore.properties
android/*.keystore
android/SIGNING_CREDENTIALS.txt

# Generated by scripts/stamp-version.js at build time
public/version.json

# Android Studio (blocks release preflight when dirty)
android/.idea/

# Play service account keys — never commit
**/play-service-account*.json
**/google-play-*.json
